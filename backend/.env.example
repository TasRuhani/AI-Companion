# Copy to .env (ignored by Git) and load it with your shell or environment manager.
DB_USERNAME=postgres
DB_PASSWORD=

# Optional local service overrides
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/companion
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
COMPANION_PORTRAIT_STORAGE_DIR=./data/companion-portraits
COMPANION_PORTRAIT_MAX_FILE_SIZE=5MB
COMPANION_PORTRAIT_MAX_REQUEST_SIZE=6MB
